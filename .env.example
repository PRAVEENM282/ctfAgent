# VulnForge configuration. Copy to .env and edit there (.env is gitignored).
# Placeholders only in this file. Compose becomes healthy with these values;
# lab creation needs a real Celesto runtime and a reachable LLM.

# ---- Celesto sandbox provider -------------------------------------------------
# local  = Celesto local runtime (firecracker/QEMU microVMs on this host; needs
#          `celesto image pull ubuntu` once and KVM). No public URL; the lab is
#          served as a local preview on 127.0.0.1.
# cloud  = Celesto Cloud (published HTTPS URL). Requires CELESTO_API_KEY.
CELESTO_PROVIDER=local
CELESTO_BACKEND=firecracker
# Guest OS for local provider (cloud ignores this).
CELESTO_OS=ubuntu
# Required only when CELESTO_PROVIDER=cloud.
CELESTO_API_KEY=

# ---- LLM provider -------------------------------------------------------------
# ollama             = local Ollama (OpenAI-compatible); no secret needed.
# openai_compatible  = any OpenAI-compatible host (Groq, OpenRouter, OpenAI, ...).
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:1.5b
# openai_compatible only: base URL + key of the remote host.
LLM_BASE_URL=
LLM_API_KEY=
# ollama only: where the Ollama server is reachable from the control plane.
# In docker this is the host; on the host directly use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Control plane ------------------------------------------------------------
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080

# ---- Lab limits and safety ----------------------------------------------------
# Optional shared secret. When set, the UI and API require X-Access-Code to
# create or manage labs.
ACCESS_CODE=
MAX_ACTIVE_LABS=1
SANDBOX_TTL_MINUTES=15

# ---- Optional agent / provider tuning (safe defaults) -------------------------
LLM_API_KEY_HEADER=
LLM_API_KEY_PREFIX=
LLM_API_FORMAT=
LLM_TIMEOUT_SECONDS=90
VULNFORGE_MAX_ITERATIONS=20
VULNFORGE_MAX_TOOL_CALLS=40
VULNFORGE_TOKEN_BUDGET=16000
VULNFORGE_REQUEST_MAX_TOKENS=8192
VULNFORGE_TIME_BUDGET_SECONDS=600
VULNFORGE_MAX_RETRIES=2
LLM_MAX_RETRIES=2
LLM_MAX_HTTP_ATTEMPTS=8
LLM_DAILY_REQUEST_LIMIT=1000
LLM_DAILY_TOKEN_LIMIT=200000
LLM_INPUT_RATE_USD_PER_MILLION=0
LLM_OUTPUT_RATE_USD_PER_MILLION=0
LLM_RATE_SOURCE=configured_free_rate
EVAL_BATCH_BUDGET_SECONDS=5400

# Trusted control-plane switches. Keep fault injection disabled by default.
VULNFORGE_INJECT_STEP7_FAILURE=0
VULNFORGE_VARIATION_SEED=
VULNFORGE_VULNERABILITY_MODE=single
VULNFORGE_VULNERABILITIES=
VULNFORGE_STATE_DIR=/var/lib/vulnforge
OPERATOR_TOKEN=
APPROVAL_API_BASE_URL=http://127.0.0.1:8080
VULNFORGE_APPROVAL_MODE=interactive
VULNFORGE_APPROVAL_TTL_SECONDS=300
VULNFORGE_PUBLIC_LEASE_SECONDS=900
VULNFORGE_STARTUP_ACTION=none
VULNFORGE_ACCOUNT_LIMIT_VERIFIED=0
