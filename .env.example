# Safe placeholders for local setup. Copy to .env and replace credentials there.
CELESTO_PROVIDER=cloud
CELESTO_BACKEND=firecracker
CELESTO_API_KEY=replace-me

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name
# Optional: defaults to Authorization + Bearer; Azure defaults to api-key with no prefix.
LLM_API_KEY_HEADER=
LLM_API_KEY_PREFIX=
# Select `anthropic-messages` or `bedrock-converse` for those APIs. Anthropic is
# selected automatically for LLM_PROVIDER=anthropic; Bedrock Nova Micro selects
# Converse automatically. Other provider/model pairs default to OpenAI-compatible chat.
LLM_API_FORMAT=
LLM_TIMEOUT_SECONDS=90
# Backward-compatible aliases for existing Bedrock setups.
BEDROCK_BASE_URL=
BEDROCK_API_KEY=
BEDROCK_MODEL=

DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080

# Per-attempt agent budgets and bounded recovery.
VULNFORGE_MAX_ITERATIONS=20
VULNFORGE_MAX_TOOL_CALLS=40
VULNFORGE_TOKEN_BUDGET=16000
VULNFORGE_REQUEST_MAX_TOKENS=8192
VULNFORGE_TIME_BUDGET_SECONDS=600
VULNFORGE_MAX_RETRIES=2
LLM_MAX_RETRIES=2
LLM_MAX_HTTP_ATTEMPTS=8
LLM_DAILY_REQUEST_LIMIT=1000
LLM_DAILY_TOKEN_LIMIT=200000
LLM_INPUT_RATE_USD_PER_MILLION=0
LLM_OUTPUT_RATE_USD_PER_MILLION=0
LLM_RATE_SOURCE=configured_free_rate
EVAL_BATCH_BUDGET_SECONDS=5400

# Trusted control-plane runtime switches. Keep fault injection disabled by default.
VULNFORGE_INJECT_STEP7_FAILURE=0
VULNFORGE_VARIATION_SEED=
VULNFORGE_STATE_DIR=/var/lib/vulnforge
OPERATOR_TOKEN=replace-me
APPROVAL_API_BASE_URL=http://127.0.0.1:8080
VULNFORGE_APPROVAL_MODE=interactive
VULNFORGE_APPROVAL_TTL_SECONDS=300
VULNFORGE_PUBLIC_LEASE_SECONDS=900
VULNFORGE_STARTUP_ACTION=none
VULNFORGE_ACCOUNT_LIMIT_VERIFIED=0
